{
  "name": "diagfren",
  "displayName": "diagfren",
  "description": "Ctrl+click code references in ASCII diagrams to jump to source.",
  "version": "0.0.1",
  "publisher": "kanban",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:plaintext",
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "diagfren",
      "properties": {
        "diagfren.sidecarPath": {
          "type": "string",
          "default": ".diagfren",
          "description": "Path to the sidecar folder containing .anchors files, relative to the workspace root."
        }
      }
    },
    "commands": [
      {
        "command": "diagfren.statusPage",
        "title": "diagfren: Status Page"
      },
      {
        "command": "diagfren.copyWithRefs",
        "title": "diagfren: Copy with Code Refs"
      },
      {
        "command": "diagfren.debugCopy",
        "title": "diagfren: Debug Copy"
      },
      {
        "command": "diagfren.createLink",
        "title": "diagfren: Link Selection to Code"
      },
      {
        "command": "diagfren.confirmLink",
        "title": "diagfren: Confirm Link at Cursor"
      },
      {
        "command": "diagfren.cancelLink",
        "title": "diagfren: Cancel Link Creation"
      }
    ],
    "keybindings": [
      {
        "command": "diagfren.copyWithRefs",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "editorTextFocus && editorHasSelection && diagfren.hasAnchors && editorLangId =~ /^(plaintext|markdown)$/"
      },
      {
        "command": "diagfren.createLink",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus && editorHasSelection && editorLangId =~ /^(plaintext|markdown)$/"
      },
      {
        "command": "diagfren.confirmLink",
        "key": "alt+enter",
        "when": "diagfren.selectLinkMode && editorTextFocus"
      },
      {
        "command": "diagfren.cancelLink",
        "key": "escape",
        "when": "diagfren.selectLinkMode"
      }
    ]
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "pretest": "tsc",
    "test": "vscode-test",
    "test:xvfb": "xvfb-run -a npm test",
    "package": "npx @vscode/vsce package --no-dependencies --out dist/",
    "serve": "./start-server.sh"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "mocha": "^11.7.5",
    "typescript": "^5.4.0"
  }
}
